  "scenes": [
    {
      "start": 0,
      "chapter": "BIENVENUE",
      "title": "Un petit guide. Un grand tour.",
      "text": "Découvrons le portfolio d’Adam Giuglardo, étape par étape."
    },
    {
      "start": 3.341,
      "chapter": "À PROPOS DE MOI",
      "title": "Comprendre. Connecter. Sécuriser.",
      "text": "Un parcours en Réseaux & Télécommunications, construit projet après projet."
    },
    {
      "start": 5.744,
      "chapter": "PROJETS",
      "title": "Projet intégratif SAE 2.04",
      "text": "Une infrastructure d’entreprise : routage, services et administration réseau."
    },
    {
      "start": 11.61,
      "chapter": "PROJETS",
      "title": "Infrastructure réseau",
      "text": "Du Wi-Fi, de l’adressage et des services sur de vrais équipements."
    },
    {
      "start": 17.427,
      "chapter": "PROJETS",
      "title": "Portfolio",
      "text": "Le site que tu explores : mon parcours, mes compétences et mes réalisations."
    },
    {
      "start": 23.143,
      "chapter": "PROJETS",
      "title": "Analyse de signaux",
      "text": "Observer les signaux, mesurer leurs propriétés et interpréter les résultats."
    },
    {
      "start": 28.843,
      "chapter": "PROJETS",
      "title": "Téléphonie sur IP",
      "text": "Faire communiquer des postes SIP, DECT et analogiques grâce à un IPBX."
    },
    {
      "start": 34.481,
      "chapter": "COMPÉTENCES",
      "title": "Installation d’équipements",
      "text": "Switchs Cisco, routeurs et points d’accès : apprendre à connecter les équipements."
    },
    {
      "start": 38.614,
      "chapter": "COMPÉTENCES",
      "title": "Virtualisation",
      "text": "VMware et VirtualBox pour déployer des serveurs et simuler des architectures."
    },
    {
      "start": 42.777,
      "chapter": "COMPÉTENCES",
      "title": "Services réseau",
      "text": "DNS, DHCP, Active Directory et SSH : les services au cœur du réseau."
    },
    {
      "start": 46.943,
      "chapter": "COMPÉTENCES",
      "title": "Développement Web",
      "text": "Créer des interfaces web pour présenter des informations et des projets."
    },
    {
      "start": 51.11,
      "chapter": "COMPÉTENCES",
      "title": "Bash & Linux",
      "text": "Administrer Linux et automatiser les tâches avec des scripts Bash."
    },
    {
      "start": 55.276,
      "chapter": "COMPÉTENCES",
      "title": "Python",
      "text": "Développer des scripts et traiter des données avec Python."
    },
    {
      "start": 59.443,
      "chapter": "COMPÉTENCES",
      "title": "Bases de données",
      "text": "Organiser les données et travailler avec les bases de données."
    },
    {
      "start": 63.609,
      "chapter": "COMPÉTENCES",
      "title": "GBF",
      "text": "Générer des signaux pour les observer et les comparer."
    },
    {
      "start": 67.775,
      "chapter": "COMPÉTENCES",
      "title": "Oscilloscope",
      "text": "Mesurer l’amplitude, la période et le bruit à l’oscilloscope."
    },
    {
      "start": 71.942,
      "chapter": "COMPÉTENCES",
      "title": "Téléphonie sur IP (VoIP)",
      "text": "Configurer et tester des communications téléphoniques sur IP."
    },
    {
      "start": 76.108,
      "chapter": "FORMATION",
      "title": "Un parcours tourné vers le numérique",
      "text": "Le BUT Réseaux & Télécommunications, à l’IUT Clermont Auvergne."
    },
    {
      "start": 80.24,
      "chapter": "QUALITÉS PERSONNELLES",
      "title": "Assiduité",
      "text": "Des routines et des échéances pour avancer avec constance."
    },
    {
      "start": 83.842,
      "chapter": "QUALITÉS PERSONNELLES",
      "title": "Organisation",
      "text": "Planifier, découper les étapes et garder ses projets organisés."
    },
    {
      "start": 87.458,
      "chapter": "QUALITÉS PERSONNELLES",
      "title": "Patience",
      "text": "Tester, comprendre l’erreur et chercher une solution, étape par étape."
    },
    {
      "start": 91.058,
      "chapter": "QUALITÉS PERSONNELLES",
      "title": "Efficacité",
      "text": "Choisir des méthodes simples et automatiser ce qui peut l’être."
    },
    {
      "start": 94.641,
      "chapter": "QUALITÉS PERSONNELLES",
      "title": "Esprit d’équipe",
      "text": "Écouter, communiquer et avancer ensemble vers un objectif commun."
    },
    {
      "start": 98.257,
      "chapter": "QUALITÉS PERSONNELLES",
      "title": "Prévenance",
      "text": "Soigner les détails et anticiper les besoins des autres."
    },
    {
      "start": 101.873,
      "chapter": "LANGUES",
      "title": "Échanger dans plusieurs langues",
      "text": "Français, anglais, italien, arabe et espagnol : cinq langues présentées sur le site."
    },
    {
      "start": 104.438,
      "chapter": "DIVERS",
      "title": "Et en dehors des réseaux ?",
      "text": "Veille technologique, travail en équipe, jeux vidéo, musique et podcasts."
    },
    {
      "start": 108.471,
      "chapter": "C.V",
      "title": "Tout mon parcours, dans un document",
      "text": "Le CV est consultable et téléchargeable directement depuis le portfolio."
    },
    {
      "start": 112.142,
      "chapter": "CODE",
      "title": "Le portfolio a un autre niveau",
      "text": "Un code d’accès ouvre l’arcade du portfolio et ses cinq jeux."
    },
    {
      "start": 115.568,
      "chapter": "CONTACT",
      "title": "Construisons la suite",
      "text": "Une alternance, un projet ou un échange : les coordonnées sont à portée de clic."
    },
    {
      "start": 118.837,
      "chapter": "À TOI DE JOUER",
      "title": "La visite continue avec toi",
      "text": "Explore les projets, ouvre les compétences et prenons contact."
    }
  ],
